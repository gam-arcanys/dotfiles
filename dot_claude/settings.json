{
  "model": "claude-fable-5[1m]",
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "voiceEnabled": true,
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook idle" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook working" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook working" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook notification" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook idle" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-hook clear" }] }
    ]
  }
}
